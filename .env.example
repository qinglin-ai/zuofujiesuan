# 部署/本地运行环境变量模板：复制本文件为 .env 后填写（.env 不入库）
# docker compose up 会自动读取根目录 .env。

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_APP_PASSWORD=change_me_app

JWT_SECRET=change_me_a_long_random_secret

# 微信小程序凭据（注册后填写）
WX_APPID=
WX_SECRET=

# === 微信支付 商家转账到零钱（自动打款，docker-compose 透传给后端）===
WXPAY_ENABLED=0                 # 1=启用自动打款；0=沿用半自动 manual 确认
WX_MCHID=                        # 商户号
WXPAY_API_V3_KEY=                # 32位 APIv3 密钥
WXPAY_MCH_SERIAL_NO=             # 商户API证书序列号
WXPAY_MCH_PRIVATE_KEY_PATH=certs/apiclient_key.pem
WXPAY_PLATFORM_PUBLIC_KEY_PATH=certs/pub_key.pem
WXPAY_PLATFORM_PUBLIC_KEY_ID=    # 微信支付公钥ID
WXPAY_NOTIFY_URL=                # 公网 HTTPS 回调 https://<domain>/api/pay/transfer/notify
WXPAY_TRANSFER_SCENE_ID=1000
WXPAY_SCENE_REPORT_INFOS=[{"info_type":"提现说明","info_content":"兼职佣金提现"}]
WXPAY_RETRY_MAX=1
WXPAY_HTTP_TIMEOUT=10
WXPAY_MOCK=0                     # 1=本地模拟（生产必须为0）