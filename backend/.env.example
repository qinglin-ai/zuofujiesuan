# 复制为 .env 并填入真实值（.env 不入库）
# === 运行环境 ===
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# === MySQL 连接 ===
# 格式: mysql+pymysql://<user>:<pass>@<host>:<port>/<db>?charset=utf8mb4
DB_URI=mysql+pymysql://root:your_password@127.0.0.1:3306/zuofu_parttime?charset=utf8mb4

# === JWT 签名密钥（生产环境必须替换为强随机值）===
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE_HOURS=72

# === 微信小程序（尚未注册时留空占位，注册后填入）===
WX_APPID=
WX_SECRET=