# 复制为 .env 并填入真实值（.env 不入库）
# === 运行环境 ===
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# === MySQL 连接 ===
# 格式: mysql+pymysql://<user>:<pass>@<host>:<port>/<db>?charset=utf8mb4
DB_URI=mysql+pymysql://root:your_password@127.0.0.1:3306/zuofu_parttime?charset=utf8mb4

# === JWT 签名密钥（生产环境必须替换为强随机值）===
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE_HOURS=72

# === 微信小程序（尚未注册时留空占位，注册后填入）===
WX_APPID=
WX_SECRET=

# === 微信支付 商家转账到零钱（自动打款）===
# 0=未启用（沿用半自动 manual 确认）；1=启用，提现申请即自动调用微信转账API打款
WXPAY_ENABLED=0
# 商户号（商户平台-账户中心-商户信息）
WX_MCHID=
# 32位 APIv3 密钥（商户平台-账户中心-API安全）
WXPAY_API_V3_KEY=
# 商户API证书序列号（商户平台-账户中心-API安全-API证书）
WXPAY_MCH_SERIAL_NO=
# 商户API私钥文件路径（相对 backend 目录；容器内为 /app/certs，本地为 backend/certs）
WXPAY_MCH_PRIVATE_KEY_PATH=certs/apiclient_key.pem
# 微信支付公钥文件路径（商户平台-账户中心-API安全-微信支付公钥）
WXPAY_PLATFORM_PUBLIC_KEY_PATH=certs/pub_key.pem
# 微信支付公钥ID（加密 user_name 的 Wechatpay-Serial 头 + 回调验签比对）
WXPAY_PLATFORM_PUBLIC_KEY_ID=
# 公网 HTTPS 回调地址，如 https://yourdomain.com/api/pay/transfer/notify
WXPAY_NOTIFY_URL=
# 转账场景ID（商户平台-产品中心-商家转账中申请，如 1000 现金营销）
WXPAY_TRANSFER_SCENE_ID=1000
# 转账场景报备信息（JSON，info_type 必须严格匹配商户已申请场景的枚举值）
WXPAY_SCENE_REPORT_INFOS=[{"info_type":"提现说明","info_content":"兼职佣金提现"}]
# 转账最终失败(FAIL)时自动换单重试的次数上限（默认1次）
WXPAY_RETRY_MAX=1
# 微信支付接口 HTTP 超时（秒）
WXPAY_HTTP_TIMEOUT=10
# 1=本地模拟客户端（无需真实凭据/网络，用于打通链路；生产必须为0）
WXPAY_MOCK=0