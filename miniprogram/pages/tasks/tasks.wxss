.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f6f8;
}
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
}
.mine-link {
  color: #1989fa;
  font-size: 28rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  flex: 1;
}
.badge {
  font-size: 22rpx;
  color: #fa8c16;
  background: #fff7e6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.card-meta {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 6rpx;
}
.card-ops {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 16rpx;
}
.my-status {
  color: #999;
  font-size: 26rpx;
}
