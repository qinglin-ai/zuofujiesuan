.page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
  min-height: 100vh;
}
.brand {
  text-align: center;
  margin-bottom: 80rpx;
}
.brand-title {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
}
.brand-sub {
  display: block;
  margin-top: 12rpx;
  color: #888;
  font-size: 28rpx;
}
.login-btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
}
.tip {
  margin-top: 24rpx;
  text-align: center;
  color: #e64340;
  font-size: 26rpx;
}