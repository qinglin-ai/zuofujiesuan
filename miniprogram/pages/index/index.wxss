.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 40rpx;
  box-sizing: border-box;
}
.header {
  font-size: 38rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 60rpx;
}
.profile {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.status {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 32rpx;
}
.status.on {
  color: #1aad19;
}
.main-btn {
  width: 60%;
  border-radius: 44rpx;
  background: #1989fa;
  color: #fff;
}
.main-btn.plain {
  background: #fff;
  color: #d43c33;
  border: 1rpx solid #d43c33;
}
.dev {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}
.dev-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}
.result {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  color: #333;
  font-size: 26rpx;
  line-height: 1.7;
}