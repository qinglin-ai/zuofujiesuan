<view class="page">
  <view class="header">左辅云创 · 兼职小程序</view>

  <view class="profile">
    <view class="status {{logged ? 'on' : ''}}">{{logged ? '已登录' : '未登录'}}</view>
    <button wx:if="{{!logged}}" class="main-btn" bindtap="goLogin">去登录</button>
    <view wx:else class="actions">
      <button class="main-btn cert" bindtap="goCertify">能力认证</button>
      <button class="main-btn plain" bindtap="onLogout">退出登录</button>
    </view>
  </view>

  <!-- 开发环境诊断：仅开发版显示，正式版不展示 -->
  <view class="dev" wx:if="{{devMode}}">
    <view class="dev-title">开发环境诊断</view>
    <button size="mini" bindtap="onHealth">后端连通性检查</button>
    <view class="result" wx:if="{{ping}}">
      <view>ping: {{ping.code}} {{ping.message}}</view>
      <view>db: {{dbOk ? 'ok' : 'fail'}}</view>
    </view>
  </view>
</view>